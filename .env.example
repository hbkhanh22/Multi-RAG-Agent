# ============================================
# Multi-RAG Agent System - Environment Config
# ============================================
# Copy this file to .env and fill in your values

# ============= GOOGLE LLM CONFIGURATION =============
# Get your Google API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ============= LLM MODELS =============
# Available Google Models:
# - gemini-2.0-flash (recommended - fastest, best for agents)
# - gemini-1.5-flash (budget option)
# - gemini-1.5-pro (more powerful, slower)
DEFAULT_LLM_MODEL=gemini-2.0-flash
FAST_LLM_MODEL=gemini-1.5-flash
POWERFUL_LLM_MODEL=gemini-2.0-flash

# Model parameters
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=300

# ============= EMBEDDING CONFIGURATION =============
# Google embedding model
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=100

# ============= RETRIEVAL CONFIGURATION =============
CHUNK_SIZE=512
CHUNK_OVERLAP=64

TOP_K_RETRIEVAL=10
TOP_K_RERANK=4

# Hybrid retrieval weights
VECTOR_WEIGHT=0.6
BM25_WEIGHT=0.4

# Reranking
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
USE_RERANKER=true

# ============= DATA PATHS =============
DATA_DIR=data
FINANCE_DATA_PATH=data/raw/finance
TECH_DATA_PATH=data/raw/tech
GENERAL_DATA_PATH=data/raw/general

FINANCE_STORE_PATH=data/vectorstores/finance_store
TECH_STORE_PATH=data/vectorstores/tech_store
GENERAL_STORE_PATH=data/vectorstores/general_store

PROCESSED_DATA_PATH=data/processed

# ============= AGENT CONFIGURATION =============
ROUTER_TEMPERATURE=0.0
ROUTER_MAX_TOKENS=500

SUPERVISOR_MAX_ITERATIONS=3
SUPERVISOR_TIMEOUT=600

SYNTHESIZER_TEMPERATURE=0.0
SYNTHESIZER_MAX_TOKENS=2000

# ============= DOCUMENT PROCESSING =============
SUPPORTED_FILE_TYPES=[".pdf",".txt",".md",".docx"]
MAX_FILE_SIZE_MB=100

# ============= OUTPUT CONFIGURATION =============
INCLUDE_SOURCE_ATTRIBUTION=true
INCLUDE_CONFIDENCE_SCORES=true
INCLUDE_PROCESSING_TIME=true

# ============= LOGGING =============
LOG_LEVEL=INFO
LOG_DIR=logs

# ============= CACHE =============
USE_CACHE=true
CACHE_TTL_SECONDS=3600

# ============= PERFORMANCE =============
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=300
