# ============================================
# Multi-RAG Agent System - Environment Config
# Copy to .env and fill in your values:  cp .env.example .env
# ============================================

# ---- LLM provider: NVIDIA NIM (https://build.nvidia.com) ----
NVIDIA_API_KEY=nvapi-your-key-here

DEFAULT_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
FAST_LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
POWERFUL_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=300

# ---- Embedding (local HuggingFace model) ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# ---- Retrieval ----
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=10
TOP_K_RERANK=4
# Hybrid (vector + BM25) fusion weights
VECTOR_WEIGHT=0.6
BM25_WEIGHT=0.4
# Cross-encoder reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
USE_RERANKER=true
# Chunks whose rerank score is below this are treated as "not relevant"
# (triggers cross-domain / web fallback)
RELEVANCE_THRESHOLD=0.05

# ---- API ----
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# ---- Logging ----
LOG_LEVEL=INFO
