# ============================================
# Multi-RAG Agent System - Environment Config
# Copy to .env and fill in your values:  cp .env.example .env
# .env and .env.example have the same variables in the same order; only values differ.
# Never put real keys in .env.example (it is committed).
# ============================================

# ---- LLM provider: NVIDIA NIM (https://build.nvidia.com) ----
NVIDIA_API_KEY=nvapi-your-key-here

DEFAULT_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
FAST_LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=300
ROUTER_MAX_TOKENS=500

# ---- Web search ----
# Tavily API key (https://app.tavily.com). Empty => ddgs only (scrapes public search
# pages, frequently blocked).
TAVILY_API_KEY=
# basic (1 credit per search) | advanced (2 credits)
TAVILY_SEARCH_DEPTH=basic
# "today" for web questions, hours from UTC
LOCAL_UTC_OFFSET=7

# ---- Image generation (FLUX on NIM) ----
IMAGE_ENABLED=true
IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
IMAGE_FALLBACK_MODEL=black-forest-labs/flux.1-schnell
# per user
IMAGE_LIMIT_PER_HOUR=20

# ---- Chat attachments ----
# Images and scanned PDF pages are read by a vision model on NIM
VISION_LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
VISION_FALLBACK_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
ATTACHMENT_MAX_MB=20
ATTACHMENT_MAX_FILES=5
# scanned PDF pages read per file (one vision call each)
ATTACHMENT_MAX_SCAN_PAGES=10

# ---- Embedding (local HuggingFace model) ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16

# ---- Retrieval ----
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=10
TOP_K_RERANK=4
# Hybrid (vector + BM25) fusion weights
VECTOR_WEIGHT=0.6
BM25_WEIGHT=0.4
# Cross-encoder reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
USE_RERANKER=true
# Chunks whose rerank score is below this are treated as "not relevant"
# (triggers cross-domain / web fallback)
RELEVANCE_THRESHOLD=0.05

# ---- API ----
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# ---- Logging ----
LOG_LEVEL=INFO

# ============================================
# Infrastructure. Defaults = single-machine dev mode:
# SQLite + Chroma + torch models + local data/raw + in-process worker.
# docker-compose.yml overrides these for the production-like stack.
# ============================================

# Relational DB (conversations, document registry, ingest job queue).
# Empty => SQLite at data/memory.db
DATABASE_URL=
# chroma (embedded, dev) | pgvector (PostgreSQL, production)
VECTOR_BACKEND=chroma
# auto (onnx if exported, else torch) | torch (fp32) | onnx (int8, run scripts/export_onnx.py first)
MODEL_BACKEND=auto

# Documents: local (data/raw/<domain>) | s3 (AWS S3 / MinIO / R2 / GCS interop)
DOCUMENT_STORAGE=local
S3_ENDPOINT_URL=
S3_BUCKET=rag-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Pull the ONNX models from s3://$S3_BUCKET/$MODELS_S3_PREFIX at container start
# (upload once with: python scripts/sync_models.py push)
MODELS_S3_PREFIX=

# Ingestion: inline (thread in the API) | external (python -m src.worker)
INGEST_WORKER=inline
# Re-index automatically when files under data/raw change (local storage)
WATCH_DOCUMENTS=true

# Guards
RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_MB=50
# Required for /api/documents* when set (send "Authorization: Bearer <token>")
ADMIN_TOKEN=

# Observability
LOG_JSON=false
METRICS_ENABLED=true
# Langfuse tracing: create a project on https://cloud.langfuse.com and paste its keys.
# Prompts / outputs are PII-masked before they are sent (PII_REDACTION).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================
# Security
# ============================================
# Off => single anonymous user, shared conversations (dev). On => accounts + roles.
AUTH_ENABLED=false
# Long random string (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))").
# Required when AUTH_ENABLED=true, otherwise sessions die on restart.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
ALLOW_REGISTRATION=true
# Admin (document management) when the address is proven by Google sign-in. Registering these
# addresses with a password is refused. Admin with a password:
#   docker compose exec api python -m src.auth.cli admin you@example.com
ADMIN_EMAILS=
# true when served over HTTPS
COOKIE_SECURE=false
# Google sign-in: OAuth client (Web application) from Google Cloud Console.
# Authorised redirect URI: $PUBLIC_BASE_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Guardrails: NemoGuard safety classifier on NIM + prompt-injection patterns
GUARDRAILS_ENABLED=true
GUARD_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
# categories that do not block (users sharing their own contact details)
GUARD_ALLOWED_CATEGORIES=PII/Privacy
# mask e-mails / phones / ID / card numbers in logs and traces
PII_REDACTION=true

# ---- docker compose only ----
PYTHONPATH=.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
# Any Postgres 17 image with pgvector and the standard entrypoint. Where Docker Hub is
# unreachable: ghcr.io/tensorchord/vchord-postgres:pg17-v0.5.3 (pgvector 0.8.1 included)
POSTGRES_IMAGE=pgvector/pgvector:pg17
# only with --profile s3 and DOCUMENT_STORAGE=s3
MINIO_ROOT_USER=rag
MINIO_ROOT_PASSWORD=change-me-too
WEB_PORT=8080
WEB_CONCURRENCY=2
# build: the web image runs `npm run build` (needs node:22-alpine from Docker Hub)
# prebuilt: copies frontend/dist built on the host (VITE_API_BASE_URL=. npm run build)
WEB_DIST=build
GRAFANA_ADMIN_PASSWORD=change-me
